{
  "name": "code-purifier",
  "version": "1.0.0",
  "private": true,
  "description": "Client-side CSS & JavaScript purifier. Removes unused CSS and dead JavaScript with confidence-scored, AST-based analysis.",
  "type": "module",
  "engines": {
    "node": ">=20.3"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/prod.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "engine:cli": "node scripts/purify-cli.mjs"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "acorn": "^8.19.0",
    "acorn-jsx": "^5.3.2",
    "css-tree": "^3.2.1",
    "fflate": "^0.8.3",
    "htmlparser2": "^12.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "terser": "^5.51.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
